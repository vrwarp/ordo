{
  "name": "ordo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ordo/hub dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:pages": "pnpm --filter @ordo/demo build:pages",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "soak": "pnpm --filter @ordo/soak start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "fast-check": "^4.10.2",
    "pptxgenjs": "4.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
